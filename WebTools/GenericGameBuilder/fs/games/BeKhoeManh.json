 "vars": {
  "need": "an",
  "stars": 0,
  "stage": 0
 },
 "scene": [
  {
   "fill": true,
   "look": {
    "item": "garden"
   }
  },
  {
   "fill": true,
   "look": {
    "color": "#FFFFFF"
   },
   "alpha": 0.12
  },
  {
   "look": {
    "shape": "star",
    "color": "#CFC6B2"
   },
   "x": 0.3,
   "y": 0.945,
   "w": 0.075,
   "bind": {
    "color": "$stars>0?\"#FFC83D\":\"#CFC6B2\""
   },
   "smooth": 0.2
  },
  {
   "look": {
    "shape": "star",
    "color": "#CFC6B2"
   },
   "x": 0.4,
   "y": 0.945,
   "w": 0.075,
   "bind": {
    "color": "$stars>1?\"#FFC83D\":\"#CFC6B2\""
   },
   "smooth": 0.2
  },
  {
   "look": {
    "shape": "star",
    "color": "#CFC6B2"
   },
   "x": 0.5,
   "y": 0.945,
   "w": 0.075,
   "bind": {
    "color": "$stars>2?\"#FFC83D\":\"#CFC6B2\""
   },
   "smooth": 0.2
  },
  {
   "look": {
    "shape": "star",
    "color": "#CFC6B2"
   },
   "x": 0.6,
   "y": 0.945,
   "w": 0.075,
   "bind": {
    "color": "$stars>3?\"#FFC83D\":\"#CFC6B2\""
   },
   "smooth": 0.2
  },
  {
   "look": {
    "shape": "star",
    "color": "#CFC6B2"
   },
   "x": 0.7,
   "y": 0.945,
   "w": 0.075,
   "bind": {
    "color": "$stars>4?\"#FFC83D\":\"#CFC6B2\""
   },
   "smooth": 0.2
  },
  {
   "id": "bi",
   "role": "actor",
   "look": {
    "item": "bi_an"
   },
   "x": 0.5,
   "y": 0.585,
   "w": 0.36,
   "h": 0.47,
   "bind": {
    "item": "\"bi_\"+$need",
    "scale": "0.82+0.12*min($stage,3)"
   }
  }
 ],
 "flow": {
  "gen": {
   "type": "set",
   "p": {
    "n": 3,
    "startItems": 99,
    "targetWhere": "item.tags.good==$need",
    "otherWhere": "has(item.tags.bad,$need)"
   }
  },
  "views": [
   {
    "type": "cards",
    "p": {
     "y": 0.145,
     "sizeU": 0.28,
     "tall": 1.05,
     "fig": 0.8,
     "label": 1,
     "bg": "#FFFFFF"
    }
   }
  ],
  "judge": {
   "type": "equals",
   "p": {
    "finishSec": 0.3
   }
  },
  "text": {
   "prompt": "{{label(\"bi_\"+$need)}}",
   "wrong": "{{tag(tapped.itemId,\"why\")}}"
  },
  "on": {
   "start": [
    {
     "do": "bag",
     "var": "need",
     "values": "an,uong,ngu,van_dong,ve_sinh,lanh"
    }
   ],
   "wrong": [
    {
     "do": "sfx",
     "k": "tap"
    },
    {
     "do": "shake",
     "on": "@tapped"
    },
    {
     "do": "shake",
     "on": "#bi",
     "sec": 0.45,
     "amp": 16
    },
    {
     "do": "say",
     "text": "{{tag(tapped.itemId,\"why\")||\"Bi không cần cái này!\"}}",
     "fy": 0.4,
     "color": "#FFE27A",
     "sec": 1.8
    }
   ],
   "right": [
    {
     "do": "sfx",
     "k": "right"
    },
    {
     "do": "move",
     "on": "@tapped",
     "to": {
      "fx": 0.5,
      "fy": 0.53
     },
     "sec": 0.45,
     "wait": 0
    },
    {
     "do": "scale",
     "on": "@tapped",
     "to": 0.4,
     "sec": 0.45
    },
    {
     "do": "hide",
     "on": "@tapped"
    },
    {
     "do": "set",
     "var": "need",
     "expr": "\"happy\""
    },
    {
     "do": "bounce",
     "on": "#bi",
     "amount": 0.15,
     "sec": 0.5
    },
    {
     "do": "sfx",
     "k": "plop"
    },
    {
     "do": "inc",
     "var": "stars"
    },
    {
     "do": "if",
     "cond": "$stars>=5",
     "then": [
      {
       "do": "set",
       "var": "stars",
       "expr": "5"
      },
      {
       "do": "inc",
       "var": "stage"
      },
      {
       "do": "say",
       "text": "Bi lớn lên rồi! Khỏe quá!",
       "fy": 0.4,
       "color": "#FFE27A",
       "sec": 2
      },
      {
       "do": "confetti",
       "at": "#bi",
       "n": 22
      },
      {
       "do": "wait",
       "sec": 1.6
      },
      {
       "do": "set",
       "var": "stars",
       "expr": "0"
      }
     ],
     "else": [
      {
       "do": "say",
       "text": "Bi khỏe hơn rồi!",
       "fy": 0.4,
       "sec": 1.2
      },
      {
       "do": "wait",
       "sec": 0.8
      }
     ]
    }
   ]
  }
 },
 "version": 3,
 "desc": "Bi cần gì thì cho cái đó; đủ 5 sao thì Bi lớn lên."
}