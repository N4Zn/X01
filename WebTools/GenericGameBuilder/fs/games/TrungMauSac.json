 "flow": {
  "gen": {
   "type": "set",
   "p": {
    "startItems": 99,
    "targetWhere": "item.tags.kind==\"color\"",
    "otherWhere": "item.tags.kind==\"color\""
   }
  },
  "views": [
   {
    "type": "props",
    "p": {
     "layout": "row",
     "x0": 0.2,
     "x1": 0.8,
     "y0": 0.4,
     "y1": 0.4,
     "size": "0.25",
     "tall": 1.32,
     "preset": "none",
     "tpl": [
      {
       "look": {
        "shape": "circle",
        "color": "#B98A56"
       },
       "w": "=size*1.35",
       "h": "=size*.45",
       "dy": "=-size*.55"
      },
      {
       "look": {
        "shape": "circle",
        "color": "=opt.color"
       },
       "w": "=size",
       "h": "=size*1.32"
      },
      {
       "look": {
        "shape": "square",
        "color": "#FFFFFF"
       },
       "alpha": 0.55,
       "w": "=size*.8",
       "h": "=size*.106",
       "dy": "=-size*.066"
      },
      {
       "look": {
        "shape": "circle",
        "color": "#FFFFFF"
       },
       "alpha": 0.55,
       "w": "=size*.13",
       "dx": "=-size*.18",
       "dy": "=size*.264"
      },
      {
       "look": {
        "shape": "circle",
        "color": "#FFFFFF"
       },
       "alpha": 0.55,
       "w": "=size*.1",
       "dx": "=size*.16",
       "dy": "=-size*.29"
      }
     ]
    }
   }
  ],
  "judge": {
   "type": "equals",
   "p": {
    "finishSec": 2.4
   }
  },
  "text": {
   "prompt": "Trứng màu {LABEL} đâu?",
   "wrong": "Trứng này màu {name} nè!"
  },
  "on": {
   "right": [
    {
     "do": "sfx",
     "k": "right"
    },
    {
     "do": "shake",
     "on": "@tapped",
     "sec": 0.4,
     "amp": 12
    },
    {
     "do": "wait",
     "sec": 0.4
    },
    {
     "do": "confetti",
     "at": "@tapped",
     "n": 8,
     "sound": 0
    },
    {
     "do": "hide",
     "on": "@tapped"
    },
    {
     "do": "spawn",
     "look": {
      "shape": "square",
      "color": "#4CAF50"
     },
     "at": {
      "ref": "@tapped",
      "dy": -0.16
     },
     "w": 0.025,
     "h": 0.16,
     "pop": 0
    },
    {
     "do": "spawn",
     "look": {
      "shape": "flower",
      "color": "=tapped.item.color"
     },
     "at": {
      "ref": "@tapped",
      "dy": 0.02
     },
     "size": 0.3
    },
    {
     "do": "spawn",
     "look": {
      "item": "=tapped.item.tags.fruit"
     },
     "at": {
      "ref": "@tapped",
      "dx": 0.11,
      "dy": 0.17
     },
     "size": 0.17
    },
    {
     "do": "spawn",
     "look": {
      "text": "=tapped.name",
      "fs": 0.068,
      "color": "#FFFFFF"
     },
     "at": {
      "ref": "@tapped",
      "dy": -0.3
     },
     "w": 0.5,
     "h": 0.1
    }
   ]
  }
 },
 "version": 3,
 "desc": "Chạm trứng đúng màu → nở hoa + trái cây cùng màu."
}