 "flows": [
  {
   "gen": {
    "type": "match",
    "p": {
     "subjectWhere": "item.tags.story==1 && ($_task>=4 || item.tags.hour%3==0)",
     "optionsWhere": "item.tags.opt==1",
     "n": 12,
     "answerTag": "optid",
     "shuffle": 0,
     "noRepeat": 1
    }
   },
   "views": [
    {
     "type": "props",
     "p": {
      "layout": "circle",
      "cx": 0.5,
      "cy": 0.46,
      "r": 0.325,
      "startDeg": 30,
      "size": "0.15",
      "preset": "none",
      "tpl": [
       {
        "look": {
         "shape": "circle",
         "color": "=(opt.id==\"h3\"||opt.id==\"h6\"||opt.id==\"h9\"||opt.id==\"h12\")?\"#FFD27A\":\"#CFE8FF\""
        },
        "w": "=size"
       },
       {
        "look": {
         "text": "=opt.label",
         "fs": 0.088,
         "color": "#2A2F55",
         "outline": 0
        },
        "w": 0.14,
        "h": 0.14
       }
      ]
     }
    }
   ],
   "judge": {
    "type": "equals",
    "p": {
     "finishSec": 1.5
    }
   },
   "text": {
    "prompt": "{subject}\nĐặt đồng hồ {{q.subject.tags.hour}} giờ!",
    "wrong": ""
   },
   "on": {
    "setup": [
     {
      "do": "rotate",
      "on": "#hand",
      "to": 0,
      "sec": 0
     },
     {
      "do": "text",
      "on": "#digital",
      "text": ""
     }
    ],
    "wrong": [
     {
      "do": "sfx",
      "k": "wrong"
     },
     {
      "do": "rotate",
      "on": "#hand",
      "to": "=-((tapped.key+1)%12)*30",
      "sec": 0.6
     },
     {
      "do": "say",
      "text": "Kim đang chỉ {{tapped.key+1}}, chưa phải {{q.subject.tags.hour}} giờ!",
      "fy": 0.12,
      "color": "#FFE27A",
      "sec": 1.4
     },
     {
      "do": "wait",
      "sec": 1
     },
     {
      "do": "rotate",
      "on": "#hand",
      "to": 0,
      "sec": 0.5
     }
    ],
    "right": [
     {
      "do": "sfx",
      "k": "right"
     },
     {
      "do": "rotate",
      "on": "#hand",
      "to": "=-(q.subject.tags.hour%12)*30",
      "sec": 0.7
     },
     {
      "do": "text",
      "on": "#digital",
      "text": "{{q.subject.tags.hour}}:00"
     },
     {
      "do": "bounce",
      "on": "@tapped",
      "amount": 0.2,
      "sec": 0.5
     },
     {
      "do": "say",
      "text": "{{q.subject.tags.hour}} giờ! Giỏi quá!",
      "fy": 0.12,
      "sec": 1.8
     },
     {
      "do": "confetti",
      "at": {
       "fx": 0.5,
       "fy": 0.46
      },
      "n": 12
     }
    ]
   }
  },
