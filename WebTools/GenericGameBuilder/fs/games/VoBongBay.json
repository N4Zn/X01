 "flow": {
  "gen": {
   "type": "set",
   "p": {
    "startItems": 99,
    "targetWhere": "item.tags.kind==\"balloon\"",
    "otherWhere": "item.tags.kind==\"balloon\""
   }
  },
  "views": [
   {
    "type": "props",
    "p": {
     "layout": "row",
     "x0": 0.2,
     "x1": 0.8,
     "y0": 0.52,
     "y1": 0.52,
     "size": "0.30",
     "tall": 1.33,
     "preset": "none",
     "anim": "float",
     "tpl": [
      {
       "look": {
        "item": "=opt.id"
       },
       "w": "=size*.75",
       "h": "=size"
      }
     ]
    }
   }
  ],
  "judge": {
   "type": "equals",
   "p": {
    "finishSec": 2.4
   }
  },
  "text": {
   "prompt": "Vỡ bóng màu {LABEL}!",
   "wrong": "Bóng này màu {name} nè!"
  },
  "on": {
   "right": [
    {
     "do": "sfx",
     "k": "right"
    },
    {
     "do": "sfx",
     "k": "pop"
    },
    {
     "do": "confetti",
     "at": "@tapped",
     "n": 8,
     "sound": 0
    },
    {
     "do": "hide",
     "on": "@tapped"
    },
    {
     "do": "pickItem",
     "var": "animal",
     "tag": "kind",
     "value": "animal"
    },
    {
     "do": "spawn",
     "look": {
      "item": "=$animal"
     },
     "at": "@tapped",
     "size": 0.3
    },
    {
     "do": "spawn",
     "look": {
      "text": "=label($animal)",
      "fs": 0.068,
      "color": "#FFFFFF"
     },
     "at": {
      "ref": "@tapped",
      "dy": -0.19
     },
     "w": 0.5,
     "h": 0.1,
     "pop": 0
    }
   ]
  }
 },
 "version": 3,
 "desc": "Vỡ bóng đúng màu → con vật chui ra."
