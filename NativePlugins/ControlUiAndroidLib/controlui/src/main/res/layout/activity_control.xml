<?xml version="1.0" encoding="utf-8"?>
<!-- Bố cục 4 vùng (top-left Môn học / top-right Lớp / action-zone trái nhỏ / report-zone phải
     to) + 3 tiến trình (chọn / đang chơi / hết game) — xem ControlActivity.java, render*().
     Hầu hết nội dung con dựng động bằng code (giống buildGameList() cũ) vì đổi liên tục theo
     state; XML này chỉ là khung/container rỗng có id. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============== TOP BAR: Môn học (trái) + Lớp (phải) + logo (ngoài cùng phải) ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/rail"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/category_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lớp"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/class_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="16dp"
                android:layout_marginVertical="2dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:maxWidth="176dp"
                android:src="@drawable/logo_eduxplore_transparent" />
        </LinearLayout>

        <!-- ============== BODY: action zone (trái, nhỏ) + report zone (phải, to) ============== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/action_zone"
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:background="@color/rail"
                android:padding="14dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/report_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <FrameLayout
                    android:id="@+id/panels_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Scene select/ended: Lớp học -->
                    <LinearLayout
                        android:id="@+id/panel_roster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/game_preview_strip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:padding="9dp"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/notplayed_strip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:padding="10dp"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/roster_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="6dp" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:id="@+id/roster_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingBottom="12dp" />
                        </ScrollView>
                    </LinearLayout>

                    <!-- Scene select/ended: Năng lực -->
                    <LinearLayout
                        android:id="@+id/panel_competency"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ScrollView
                            android:layout_width="150dp"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:id="@+id/comp_chips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/comp_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/comp_flags"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="6dp"
                                android:textColor="@color/live"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:id="@+id/comp_score_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/comp_note"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Tính từ kết quả buổi hôm nay: độ khó câu hỏi + đúng/sai + thời gian trả lời — công thức tạm, sẽ tinh chỉnh sau."
                                android:textColor="@color/text_faint"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Scene select/ended: Lịch sử -->
                    <ScrollView
                        android:id="@+id/panel_history"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/history_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp" />
                    </ScrollView>

                    <!-- Scene playing: live team view (thay hẳn tabs) -->
                    <LinearLayout
                        android:id="@+id/panel_live"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/live_side_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="7dp"
                            android:orientation="vertical"
                            android:background="@color/panel"
                            android:padding="16dp" />

                        <LinearLayout
                            android:id="@+id/live_side_right"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:orientation="vertical"
                            android:background="@color/panel"
                            android:padding="16dp" />
                    </LinearLayout>

                    <!-- Scene ended, bấm "Tổng kết" -->
                    <LinearLayout
                        android:id="@+id/panel_summary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/summary_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/panel"
                            android:padding="22dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
